{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pta1-logbook-insight",
  "account_id": "e87e6b4e7ec59834a35db192e7e37eb8",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  }
}
